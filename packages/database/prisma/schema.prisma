generator client {

  provider = "prisma-client-js"

}



datasource db {

  provider  = "postgresql"

  url       = env("DATABASE_URL")

  directUrl = env("DIRECT_URL")

}



model User {

  id                   String    @id @default(cuid())

  email                String    @unique

  passwordHash         String?

  displayName          String?

  intelligenceTier     String    @default("lite")

  selectedMarkets      String?

  stripeCustomerId     String?

  stripeSubscriptionId String?

  subscriptionStatus   String    @default("none")

  /** stripe | apple — which store currently owns billing */
  billingProvider      String?

  appleOriginalTransactionId String?

  appleProductId       String?

  revenueCatAppUserId  String?

  accessExpiresAt      DateTime?

  disabledAt           DateTime?

  signupCountry        String?

  signupRegion         String?

  signupCity           String?

  signupLatitude       Float?

  signupLongitude      Float?

  acquisitionChannel   String?

  simTrialStartedAt    DateTime?

  simBankroll          Float     @default(1000)

  termsAcceptedAt      DateTime?

  privacyAcceptedAt    DateTime?

  lastSeenAt           DateTime?

  totpSecret           String?

  totpEnabled          Boolean   @default(false)

  createdAt            DateTime  @default(now())

  updatedAt            DateTime  @updatedAt



  passwordResetTokens PasswordResetToken[]

  productFeedback     ProductFeedback[]

  portfolios          UserPortfolio[]

  bets                UserBet[]

  predictions         UserPrediction[]

  watchlistItems      WatchlistItem[]

  journalEntries      IntelJournalEntry[]

  intelAlerts         IntelAlert[]

  platformPrefs       PlatformPref[]

  usageEvents         UsageEvent[]

  channelTouchpoints  ChannelTouchpoint[]

  intelPref           UserIntelPref?

  ownedTeams          Team[]              @relation("TeamOwner")

  teamMemberships     TeamMember[]

  teamNotes           TeamNote[]

  apiKeys             ApiKey[]

  @@index([subscriptionStatus])

}



model UserPortfolio {

  id           String   @id @default(cuid())

  userId       String

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  module       String

  holdingsJson String   @default("[]")

  updatedAt    DateTime @updatedAt



  @@unique([userId, module])

  @@index([userId])

}



model UserBet {

  id           String    @id @default(cuid())

  userId       String

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  matchup      String

  pick         String

  odds         String?

  stake        Float?

  sport        String    @default("other")

  status       String    @default("open")

  isSimulation Boolean   @default(false)

  outcome      String?

  pnl          Float?

  settledAt    DateTime?

  createdAt    DateTime  @default(now())



  @@index([userId])

}



model UserPrediction {

  id           String    @id @default(cuid())

  userId       String

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  market       String

  category     String    @default("other")

  pick         String

  stake        Float?

  yesPrice     Float?

  status       String    @default("open")

  isSimulation Boolean   @default(false)

  outcome      String?

  pnl          Float?

  settledAt    DateTime?

  createdAt    DateTime  @default(now())



  @@index([userId])

}



model WatchlistItem {

  userId    String

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  module    String

  symbol    String

  createdAt DateTime @default(now())



  @@id([userId, module, symbol])

}



model IntelJournalEntry {

  id          String   @id @default(cuid())

  userId      String

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  module      String?

  symbol      String?

  signalTitle String?

  note        String

  createdAt   DateTime @default(now())

  updatedAt   DateTime @updatedAt



  @@index([userId])

}



model IntelAlert {

  id         String   @id @default(cuid())

  userId     String

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  module     String?

  symbol     String?

  title      String

  body       String?

  confidence Int?

  alertKey   String

  seen       Boolean  @default(false)

  createdAt  DateTime @default(now())



  @@unique([userId, alertKey])

  @@index([userId])

}



/** Phase 3 predictive prefs — theme watchlists + signal alert rules (JSON blob). */
model UserIntelPref {

  userId    String   @id

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  prefsJson String   @default("{}")

  updatedAt DateTime @updatedAt

}



/** Phase 4 — Ultra+ team workspace */
model Team {

  id        String   @id @default(cuid())

  name      String

  ownerId   String

  owner     User     @relation("TeamOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  prefsJson String   @default("{}")

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  members   TeamMember[]

  notes     TeamNote[]

  apiKeys   ApiKey[]

  @@index([ownerId])

}



model TeamMember {

  id           String   @id @default(cuid())

  teamId       String

  team         Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  userId       String?

  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  invitedEmail String?

  role         String   @default("analyst")

  status       String   @default("active")

  createdAt    DateTime @default(now())

  @@index([teamId, userId])

  @@index([teamId])

  @@index([invitedEmail])

}



model TeamNote {

  id        String   @id @default(cuid())

  teamId    String

  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  authorId  String

  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  title     String

  body      String

  themeId   String?

  symbol    String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([teamId])

  @@index([authorId])

}



/** Phase 4 — Ultra+ customer API keys (hashed) */
model ApiKey {

  id         String    @id @default(cuid())

  userId     String

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  teamId     String?

  team       Team?     @relation(fields: [teamId], references: [id], onDelete: SetNull)

  name       String

  keyPrefix  String

  keyHash    String

  lastUsedAt DateTime?

  revokedAt  DateTime?

  createdAt  DateTime  @default(now())

  @@index([userId])

  @@index([keyPrefix])

  @@index([teamId])

}



model PlatformPref {

  userId     String

  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  module     String

  platformId String

  customUrl  String?



  @@id([userId, module])

}



model UsageEvent {

  id         String   @id @default(cuid())

  userId     String?

  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  module     String?

  action     String

  endpoint   String?

  statusCode Int?

  durationMs Float?

  createdAt  DateTime @default(now())



  @@index([createdAt])

  @@index([userId])

}



model MarketingChannel {

  id        String   @id

  platform  String

  handle    String?

  url       String?

  active    Boolean  @default(true)

  createdAt DateTime @default(now())



  touchpoints ChannelTouchpoint[]

  credentials SocialChannelCredential?

  metrics     SocialMetricsSnapshot[]

}



model ChannelTouchpoint {

  id        String   @id @default(cuid())

  userId    String

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  channelId String

  channel   MarketingChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  eventType String

  amountUsd Float    @default(0)

  createdAt DateTime @default(now())



  @@index([userId])

  @@index([channelId])

}



model SocialChannelCredential {

  channelId        String   @id

  channel          MarketingChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  accountId        String?

  accessToken      String?

  refreshToken     String?

  extraJson        String?

  connectionStatus String   @default("disconnected")

  lastSyncAt       DateTime?

  syncError        String?

  updatedAt        DateTime @updatedAt

}



model SocialMetricsSnapshot {

  id             String   @id @default(cuid())

  channelId      String

  channel        MarketingChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  snapshotDate   String

  followers      Int      @default(0)

  impressions    Int      @default(0)

  profileViews   Int      @default(0)

  linkClicks     Int      @default(0)

  engagementRate Float    @default(0)

  postsCount     Int      @default(0)

  rawJson        String?

  syncedAt       DateTime @default(now())



  @@unique([channelId, snapshotDate])

}



model ProductFeedback {

  id        String   @id @default(cuid())

  userId    String?

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  email     String

  kind      String

  message   String

  pagePath  String?

  createdAt DateTime @default(now())



  @@index([createdAt])

}



model PasswordResetToken {

  id        String   @id @default(cuid())

  userId    String

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String   @unique

  expiresAt DateTime

  createdAt DateTime @default(now())



  @@index([userId])

}



/** MotiveFX Ops — durable operational stores (Master Plan P0–P3) */

model OpsTelemetryEvent {
  id                   String   @id @default(cuid())
  eventId              String   @unique
  eventName            String
  version              Int      @default(1)
  userId               String?
  sessionId            String?
  product              String?
  desk                 String?
  symbol               String?
  themeId              String?
  signalId             String?
  opportunityId        String?
  provider             String?
  environment          String
  platform             String?
  appVersion           String?
  observedAt           DateTime
  ingestedAt           DateTime @default(now())
  durationMs           Float?
  status               String?
  errorCode            String?
  metadataJson         String   @default("{}")
  sourceClass          String
  privacyClass         String
  truthState           String?
  instrumentationJson  String   @default("[]")

  @@index([eventName, observedAt])
  @@index([observedAt])
  @@index([symbol])
  @@index([provider])
}

model OpsAuditEvent {
  id           String   @id @default(cuid())
  actorId      String
  actorEmail   String
  action       String
  capability   String?
  risk         String
  targetType   String?
  targetId     String?
  reason       String?
  beforeJson   String?
  afterJson    String?
  result       String
  environment  String
  requestId    String?
  observedAt   DateTime @default(now())

  @@index([observedAt])
  @@index([actorId])
  @@index([action])
}

model OpsIncidentRecord {
  id            String   @id
  severity      String
  domain        String
  title         String
  description   String   @default("")
  firstSeen     DateTime
  lastSeen      DateTime
  status        String   @default("open")
  source        String
  href          String?
  runbook       String?
  acknowledgedBy String?
  acknowledgedAt DateTime?
  resolvedAt    DateTime?
  updatedAt     DateTime @updatedAt

  @@index([status, severity])
  @@index([lastSeen])
}

model OpsAiUsage {
  id              String   @id @default(cuid())
  userId          String?
  feature         String
  model           String
  promptVersion   String?
  inputTokens     Int      @default(0)
  outputTokens    Int      @default(0)
  totalTokens     Int      @default(0)
  estimatedCostUsd Float   @default(0)
  durationMs      Float?
  status          String   @default("ok")
  grounding       String?
  errorCode       String?
  metadataJson    String   @default("{}")
  createdAt       DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([feature, createdAt])
}

model SignalSnapshot {
  id                   String   @id @default(cuid())
  ledgerId             String   @unique
  symbol               String
  motiveSignal         Float?
  confidence           Float?
  stance               String?
  engineVersion        String
  evidenceJson         String
  signalEvidenceJson   String
  evidenceCount        Int      @default(0)
  signalEvidenceCount  Int      @default(0)
  recordedAt           DateTime
  createdAt            DateTime @default(now())

  outcomes SignalOutcome[]

  @@index([symbol, recordedAt])
  @@index([recordedAt])
}

model SignalOutcome {
  id              String   @id @default(cuid())
  snapshotId      String
  snapshot        SignalSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  symbol          String
  claim           String
  horizonDays     Int
  predictedScore  Float?
  predictedConf   Float?
  outcome         String   // CONFIRMED | PARTIAL | REJECTED | INCONCLUSIVE | PENDING
  evaluatedAt     DateTime?
  notes           String?
  createdAt       DateTime @default(now())

  @@index([symbol, outcome])
  @@index([outcome])
}

model OpsReplayJob {
  id              String   @id @default(cuid())
  periodKey       String
  periodLabel     String
  status          String   @default("queued") // queued | running | completed | failed
  asOfTimestamp   DateTime
  startedAt       DateTime?
  completedAt     DateTime?
  signalsEvaluated Int     @default(0)
  directionAccuracy Float?
  resultJson      String?
  error           String?
  createdBy       String?
  createdAt       DateTime @default(now())

  @@index([status, createdAt])
}

model MarketDnaSnapshot {
  id                   String   @id @default(cuid())
  asset                String
  version              String
  primaryDriversJson   String   @default("[]")
  negativeJson         String   @default("[]")
  currentRegime        String?
  confidence           Float?
  signal               Float?
  payloadJson          String   @default("{}")
  recordedAt           DateTime @default(now())

  @@index([asset, recordedAt])
}

model SignalGraphEdge {
  id              String   @id @default(cuid())
  fromSymbol      String
  toSymbol        String
  strength        Float
  direction       String   @default("positive")
  lagDaysMin      Int      @default(0)
  lagDaysMax      Int      @default(60)
  evidenceCount   Int      @default(0)
  stale           Boolean  @default(false)
  modelVersion    String
  payloadJson     String   @default("{}")
  recordedAt      DateTime @default(now())

  @@index([fromSymbol, toSymbol])
  @@index([recordedAt])
}

/// MotiveFX Creative Intelligence — campaign run + learning store
model CreativeCampaignRun {
  id                String   @id @default(cuid())
  objective         String
  trader            String
  angle             String
  mode              String
  platform          String
  symbol            String?
  briefJson         String   @default("{}")
  recommendedHook   String?
  recommendedScore  Float?
  approvalReady     Int      @default(0)
  blockedCount      Int      @default(0)
  resultJson        String?
  createdBy         String?
  createdAt         DateTime @default(now())

  hypotheses CreativeHypothesisRecord[]
  events     CreativePerformanceEvent[]

  @@index([createdAt])
  @@index([platform, trader])
  @@index([mode, angle])
}

model CreativeHypothesisRecord {
  id              String   @id @default(cuid())
  runId           String
  run             CreativeCampaignRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  label           String
  hookFamily      String
  hookText        String
  hookScore       Float
  visualStrategy  String
  videoOpening    String?
  captionPreview  String?
  publishBlocked  Boolean  @default(false)
  approved        Boolean  @default(false)
  payloadJson     String   @default("{}")
  createdAt       DateTime @default(now())

  events CreativePerformanceEvent[]

  @@index([runId])
  @@index([hookFamily, hookScore])
}

model CreativePerformanceEvent {
  id              String   @id @default(cuid())
  runId           String?
  run             CreativeCampaignRun? @relation(fields: [runId], references: [id], onDelete: SetNull)
  hypothesisId    String?
  hypothesis      CreativeHypothesisRecord? @relation(fields: [hypothesisId], references: [id], onDelete: SetNull)
  platform        String
  traderPersona   String?
  hookFamily      String?
  visualStrategy  String?
  videoOpening    String?
  captionStructure String?
  productFeature  String?
  cta             String?
  impressions     Int      @default(0)
  hold3s          Int      @default(0)
  watchTimeSec    Float    @default(0)
  clicks          Int      @default(0)
  landings        Int      @default(0)
  signups         Int      @default(0)
  activations     Int      @default(0)
  paid            Int      @default(0)
  notes           String?
  recordedAt      DateTime @default(now())
  createdBy       String?

  @@index([platform, recordedAt])
  @@index([hookFamily, recordedAt])
  @@index([recordedAt])
}


